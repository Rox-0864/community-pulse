# ============================================
# Community Pulse — Variables de entorno
# Copiar a .env y completar (NUNCA commitear .env)
# ============================================

# --- LLM Provider (elegir uno) ---
# Google Gemini
GEMINI_API_KEY=your_gemini_key_here
# Modelos gratis en Google AI Studio: gemini-3.5-flash-lite, gemini-3.8-flash,
# gemma-4-31b-it (open-weight). Para Gemma: GEMINI_MODEL=gemma-4-31b-it
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (respaldo)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# Groq (respaldo rápido y gratuito, API OpenAI-compatible)
# Gratis: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Fallback offline para demo/tests/CI (NO requiere API key)
# COMMUNITYLAB_LLM_BACKEND=rule_based

# --- OCI Object Storage ---
OCI_USER_ID=ocid1.user.oc1..xxxx
OCI_KEY_FILE_PATH=~/.oci/oci_api_key.pem
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_TENANCY_ID=ocid1.tenancy.oc1..xxxx
OCI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxx
OCI_BUCKET_NAME=community-pulse-activos-marketing

# --- Bot Discord ---
# Token del bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# URL del webhook de la API (ingesta en vivo); apuntar a la API corriendo
WEBHOOK_URL=http://localhost:8000/webhook
# "1" para que el bot reaccione 👀 a cada mensaje ingerido
DISCORD_REACT_ON_INGEST=0
# ⚠️ La ingesta en vivo necesita el "Message Content Intent" habilitado en el
# portal (Bot → Privileged Gateway Intents) además del token.

# --- App ---
LOG_LEVEL=INFO
BATCH_SIZE=50
API_HOST=0.0.0.0
API_PORT=8000